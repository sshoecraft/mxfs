{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ct7FvwtCyjtPYbJkbcuKr","type":"tool_result","content":"1\t#!/bin/bash\n2\t# Cluster reset for N nodes (sess34, generalizes cluster_reset.sh which is hard-coded for 2).\n3\t# Usage: cluster_reset_n.sh <n>   — destroys VMs test1..testN, restarts, preps each.\n4\t# Per RULE 3, this lives in the source tree because each session needs the same flow.\n5\t\n6\tset -u\n7\tN=\"${1:?node count required}\"\n8\tSSH=/src/mxfs/tools/mxfs_sshpass.sh\n9\tPF=/tmp/.mxfs_pass\n10\t\n11\techo \"=== virsh destroy + start test1..test$N ===\"\n12\tfor n in $(seq 1 \"$N\"); do\n13\t  ( sudo virsh destroy test$n 2>&1 | grep -vE \"^$\"; sudo virsh start test$n 2>&1 | grep -vE \"^$\" ) &\n14\tdone\n15\twait 2>/dev/null\n16\t\n17\techo \"=== wait for SSH on each + prep_tcm_node.sh ===\"\n18\tfor n in $(seq 1 \"$N\"); do\n19\t  ip=$(getent hosts test$n.vm.localdomain | awk '{print $1}')\n20\t  (\n21\t    for try in $(seq 1 30); do\n22\t      if timeout 3 \"$SSH\" \"$ip\" \"$PF\" 'echo R' 2>/dev/null | grep -q R; then break; fi\n23\t      sleep 3\n24\t    done\n25\t    out=$(cat /src/mxfs/tools/prep_tcm_node.sh | timeout 60 \"$SSH\" \"$ip\" \"$PF\" 'sudo bash -s' 2>&1 | grep -E \"PREP_OK|PREP_FAIL\" | head -1)\n26\t    printf \"test%-2s %s\\n\" \"$n\" \"$out\"\n27\t  ) &\n28\tdone\n29\twait 2>/dev/null\n30\t\n31\techo \"=== verify all $N nodes loaded ===\"\n32\tWANT_SV=$(modinfo /src/mxfs/mxfs.ko 2>/dev/null | awk '/^srcversion/{print $2}')\n33\tall_ok=1\n34\tfor n in $(seq 1 \"$N\"); do\n35\t  ip=$(getent hosts test$n.vm.localdomain | awk '{print $1}')\n36\t  sv=$(timeout 4 \"$SSH\" \"$ip\" \"$PF\" 'cat /sys/module/mxfs/srcversion 2>/dev/null' 2>/dev/null | tail -1 | tr -d \"\\r\\n \")\n37\t  if [ \"$sv\" != \"$WANT_SV\" ]; then\n38\t    printf \"test%-2s WRONG sv=%s want=%s\\n\" \"$n\" \"${sv:-NOT_LOADED}\" \"$WANT_SV\"\n39\t    all_ok=0\n40\t  fi\n41\tdone\n42\tif [ \"$all_ok\" = \"1\" ]; then\n43\t  echo \"ALL_OK srcversion=$WANT_SV\"\n44\telse\n45\t  echo \"PREP_FAIL — some nodes did not load $WANT_SV\"\n46\t  exit 1\n47\tfi\n48\t"}]},"parent_tool_use_id":null,"session_id":"cd05e5a4-1bae-4b40-b8b4-ee58800ac150","uuid":"bd24bc2b-98fb-45df-afae-0dc2d335308d","timestamp":"2026-06-11T03:30:32.942Z","tool_use_result":{"type":"text","file":{"filePath":"/src/mxfs/scripts/cluster_reset_n.sh","content":"#!/bin/bash\n# Cluster reset for N nodes (sess34, generalizes cluster_reset.sh which is hard-coded for 2).\n# Usage: cluster_reset_n.sh <n>   — destroys VMs test1..testN, restarts, preps each.\n# Per RULE 3, this lives in the source tree because each session needs the same flow.\n\nset -u\nN=\"${1:?node count required}\"\nSSH=/src/mxfs/tools/mxfs_sshpass.sh\nPF=/tmp/.mxfs_pass\n\necho \"=== virsh destroy + start test1..test$N ===\"\nfor n in $(seq 1 \"$N\"); do\n  ( sudo virsh destroy test$n 2>&1 | grep -vE \"^$\"; sudo virsh start test$n 2>&1 | grep -vE \"^$\" ) &\ndone\nwait 2>/dev/null\n\necho \"=== wait for SSH on each + prep_tcm_node.sh ===\"\nfor n in $(seq 1 \"$N\"); do\n  ip=$(getent hosts test$n.vm.localdomain | awk '{print $1}')\n  (\n    for try in $(seq 1 30); do\n      if timeout 3 \"$SSH\" \"$ip\" \"$PF\" 'echo R' 2>/dev/null | grep -q R; then break; fi\n      sleep 3\n    done\n    out=$(cat /src/mxfs/tools/prep_tcm_node.sh | timeout 60 \"$SSH\" \"$ip\" \"$PF\" 'sudo bash -s' 2>&1 | grep -E \"PREP_OK|PREP_FAIL\" | head -1)\n    printf \"test%-2s %s\\n\" \"$n\" \"$out\"\n  ) &\ndone\nwait 2>/dev/null\n\necho \"=== verify all $N nodes loaded ===\"\nWANT_SV=$(modinfo /src/mxfs/mxfs.ko 2>/dev/null | awk '/^srcversion/{print $2}')\nall_ok=1\nfor n in $(seq 1 \"$N\"); do\n  ip=$(getent hosts test$n.vm.localdomain | awk '{print $1}')\n  sv=$(timeout 4 \"$SSH\" \"$ip\" \"$PF\" 'cat /sys/module/mxfs/srcversion 2>/dev/null' 2>/dev/null | tail -1 | tr -d \"\\r\\n \")\n  if [ \"$sv\" != \"$WANT_SV\" ]; then\n    printf \"test%-2s WRONG sv=%s want=%s\\n\" \"$n\" \"${sv:-NOT_LOADED}\" \"$WANT_SV\"\n    all_ok=0\n  fi\ndone\nif [ \"$all_ok\" = \"1\" ]; then\n  echo \"ALL_OK srcversion=$WANT_SV\"\nelse\n  echo \"PREP_FAIL — some nodes did not load $WANT_SV\"\n  exit 1\nfi\n","numLines":48,"startLine":1,"totalLines":48}}}
