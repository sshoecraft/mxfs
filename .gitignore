# ---- Kernel module build artifacts ----
*.o
*.ko
*.mod
*.mod.c
*.mod.o
.*.cmd
*.symvers
Module.symvers
modules.order
.tmp_versions/

# ---- Userspace tool binaries (rebuilt by `make tools`) ----
/tools/mkfs_mxfs
/tools/chk_mxfs
/tools/resize_mxfs
/tools/fua_verify
/tools/caw_verify
/tools/mxfs_admin
/tools/handle_probe
/tools/mxfs_mmapio

# ---- Test-run captures (dmesg / timeline / stream dumps) ----
tests/**/*.txt
tests/**/*.log
tests/**/*.log.*

# ---- Rig evidence: kept on the rig host, never published. ----
# tests/evidence/ is raw rig capture (dmesg, traces, disk images): 22 GB and
# 107k files by 2026-09, past what a git host accepts in one push. Defect
# records still cite paths under it; those files exist on the rig host only.
tests/evidence/

# ---- ccloop run state: session prompts, logs and resume files. ----
# Local loop state, not project source; it holds full local paths and
# verbatim session text.
.ccloop/runs/

# ---- Harness output directory: regenerable, and enormous. ----
# tests/logs/ is where the harnesses WRITE (sf_mkdir_storm.sh,
# unmount_leak_check.sh, storm_ab_pass.sh, ag_strand_repair.sh,
# drc_lap_probe.sh, ...). A single 32-node run drops ~16MB of dmesg per
# node; it stood at 1,794 files / ~2.3GB on 2026-08-07 and none of it was
# ever tracked. Nothing here is an input to anything.
tests/logs/
*.dmesg

# ---- Kernel build dependency files (.kern.o.d, .xfs_buf.o.d, ...) ----
# Not covered by .*.cmd above.
.*.d

# ---- Editor / OS cruft ----
*.swp
*~
.DS_Store
._*

# ---- Working backups & stale copies (recoverable from git history; never ship publicly) ----
*.backup
*.backup-*
*.backup.*
*-backup
*.old

# ---- Compiled test helpers (rebuilt from the .c beside them) ----
/tests/caw/caw_align_probe
/tests/net2/net2_harness
/tests/suite/tools/fsx
/tests/suite/tools/fsx.new
/tests/fence_inflight/prprobe
/tests/tauth/bootstrap_race_test
/tests/tauth/concurrent_release_test
/tests/tauth/dlm_ledger_test
/tests/tauth/formation_test
/tests/tauth/ledger_test
/tests/tauth/pageof
/tests/tauth/tauth_test
/tests/tauth/unowned_page_test
/tests/tauth/view_format_test

# ---- ccloop session transcripts: symlinks to full raw session JSONL under
# ---- ~/.claude/projects/, absolute-path (non-portable) and can carry
# ---- arbitrary sensitive content (commands run, secrets, etc). Never track.
.ccloop/runs/*/transcripts/

# ---- Per-handoff working snapshot: transient (rewritten fresh each handoff,
# ---- NOT history — history lives in CHANGELOG.md) AND carries secrets
# ---- (test-node credentials, IPs). Never track. Durable notable-change
# ---- history goes in CHANGELOG.md; durable context goes in ccmemory.
state.md

# ---- More compiled tool binaries (rebuilt from the .c beside them) ----
/tools/caw_slotdump
/tools/recov_forge

# ---- Release packages (scripts/release.sh): built output, attached to the
# ---- GitHub release, never tracked.
/dist/

# ---- Python bytecode ----
__pycache__/
*.pyc

# ---- Raw per-node kernel-log dumps (.klog == .dmesg): same class as above,
# ---- 47 files / 555MB stood untracked on 2026-08-22. Harvested .txt proofs
# ---- beside them stay tracked via the tests/evidence rules above.
*.klog

# generated at build time from the target kernel's headers (Kbuild filechk)
/pal/linux/mxfs_libiscsi_fp.h
/pal/linux/mxfs_kcompat.h
